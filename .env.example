# ============================================================================
# DeskBot environment configuration (example file)
# Copy to `.env` and adjust for your hardware.
#
# The defaults below match the prototype:
#   - Raspberry Pi 5
#   - 1 x GC9A01 display
#   - 2 x SG90 head servos
#   - 2 x metal arm servos
#
# The app boots with **mock** backends unless you override the BACKEND lines.
#
# Every key is prefixed with DESKBOT_ and nested blocks use a double
# underscore (__) delimiter, e.g. DESKBOT_DISPLAYS__BACKEND=gc9a01.
# ============================================================================

# -- Application ---------------------------------------------------------
DESKBOT_ENV=development
DESKBOT_LOG_LEVEL=INFO
DESKBOT_TIMEZONE=Europe/Dublin
# "mock" boots with all mock drivers; "real" switches in the real USB/SPI drivers.
DESKBOT_HARDWARE=mock
# Optional path to a YAML config file (overrides defaults, under env vars):
# DESKBOT_CONFIG_FILE=/path/to/config.yaml
# Directory holding face/eye assets:
DESKBOT_ASSETS_DIR=assets
# When True, fall back to mock backends when a real driver is unavailable.
DESKBOT_USE_MOCKS=true

# -- Personality traits (0.0 - 1.0) --------------------------------------
DESKBOT_PERSONALITY__CURIOSITY=0.7
DESKBOT_PERSONALITY__ENERGY=0.6
DESKBOT_PERSONALITY__SHYNESS=0.3
DESKBOT_PERSONALITY__FRIENDLINESS=0.8
DESKBOT_PERSONALITY__PLAYFULNESS=0.7

# -- Face rendering ------------------------------------------------------
# Theme: vector | minimal | cute | pixel | retro_lcd | wireframe
DESKBOT_FACE__THEME=vector

# -- Display (single circular TFT)  --------------------------------------
# Backend options:
#   "mock"              - in-memory display used by tests and headless dev.
#   "gc9a01"            - raw SPI + GPIO driver (not always works...).
#   "circuitpython"     - Adafruit displayio + gc9a01a driver (recommended).
#   "cp" / "displayio"  - aliases for "circuitpython".
DESKBOT_DISPLAYS__BACKEND=mock
DESKBOT_DISPLAYS__BUS=0
DESKBOT_DISPLAYS__DEVICE=0
DESKBOT_DISPLAYS__WIDTH=240
DESKBOT_DISPLAYS__HEIGHT=240
DESKBOT_DISPLAYS__FPS=30
DESKBOT_DISPLAYS__ROTATION=0
# BCM GPIO number for the GC9A01's data/command pin (required on hardware).
# The wiring.md default is BCM 25 (physical pin 22). The CLI also accepts
# ``--dc-pin N`` on the command line.
DESKBOT_DISPLAYS__DC_PIN=25
# BCM GPIO number for the GC9A01's hardware RESET pin. Leave unset only if
# your board hard-wires RST to 3V3. The CLI accepts ``--reset-pin N``.
DESKBOT_DISPLAYS__RESET_PIN=24
# BCM GPIO number for the panel's BL (backlight) pin. Leave UNSET unless
# your panel's backlight is wired to a free Pi GPIO. The CLI accepts
# ``--backlight-pin N``. DO NOT drive an unknown backlight pin without
# checking its voltage / current requirements first.
# DESKBOT_DISPLAYS__BACKLIGHT_PIN=18
# SPI clock in Hz. Start at 8 MHz for first bring-up. Once colour fills
# work reliably, bump to 16 MHz and then 32 MHz. The CLI accepts
# ``--spi-hz N``.
DESKBOT_DISPLAYS__SPI_HZ=8000000
# SPI mode (0-3). GC9A01 typically wants mode 0; some clones want mode 3.
# The CLI accepts ``--spi-mode N``.
DESKBOT_DISPLAYS__SPI_MODE=0
# INVON at init (true by default for the Waveshare round TFT). Try
# ``DESKBOT_DISPLAYS__INVERT=false`` if the colours are inverted.
DESKBOT_DISPLAYS__INVERT=true
# Max bytes per SPI write. Kernel cap is 4096; do not increase unless
# you've bumped ``spidev.bufsiz=``.
DESKBOT_DISPLAYS__CHUNK_BYTES=4096

# -- Servos --------------------------------------------------------------
# Backend: "mock" for headless dev/tests, "gpio" on the Pi 5 (software PWM),
#          "pca9685" for the Adafruit PCA9685 I2C PWM driver.
DESKBOT_SERVOS__BACKEND=mock
DESKBOT_SERVOS__FREQUENCY=50

# GPIO backend settings:
DESKBOT_SERVOS__GPIO__FREQUENCY=50
# Per-servo GPIO pin (BCM numbering). Override to match your wiring.
DESKBOT_SERVOS__GPIO__PINS__PAN=12
DESKBOT_SERVOS__GPIO__PINS__TILT=13
DESKBOT_SERVOS__GPIO__PINS__LEFT_ARM=18
DESKBOT_SERVOS__GPIO__PINS__RIGHT_ARM=19
# Per-channel tuning (override min/max pulse + angle range). Keys below are
# examples for the "pan" channel; repeat for tilt / left_arm / right_arm.
# DESKBOT_SERVOS__GPIO__CHANNELS__PAN__MIN_PULSE_US=500
# DESKBOT_SERVOS__GPIO__CHANNELS__PAN__MAX_PULSE_US=2500
# DESKBOT_SERVOS__GPIO__CHANNELS__PAN__MIN_ANGLE_DEG=30
# DESKBOT_SERVOS__GPIO__CHANNELS__PAN__MAX_ANGLE_DEG=150
# DESKBOT_SERVOS__GPIO__CHANNELS__PAN__INVERTED=false

# PCA9685 backend settings (I2C PWM servo driver):
DESKBOT_SERVOS__PCA9685__ADDRESS=64
DESKBOT_SERVOS__PCA9685__BUS=1
DESKBOT_SERVOS__PCA9685__FREQUENCY=50
# Per-channel: chip / channel / min_pulse_us / max_pulse_us / min_angle_deg
# / max_angle_deg / inverted. Example for "pan":
# DESKBOT_SERVOS__PCA9685__CHANNELS__PAN__CHIP=0
# DESKBOT_SERVOS__PCA9685__CHANNELS__PAN__CHANNEL=0
# DESKBOT_SERVOS__PCA9685__CHANNELS__PAN__MIN_PULSE_US=500
# DESKBOT_SERVOS__PCA9685__CHANNELS__PAN__MAX_PULSE_US=2500

# Legacy single-board servo channels (kept for backward compatibility).
# Each accepts: MIN_PULSE_US, MAX_PULSE_US, MIN_ANGLE_DEG, MAX_ANGLE_DEG,
# INVERTED, GPIO_PIN.
DESKBOT_SERVOS__HEAD_PAN__GPIO_PIN=12
DESKBOT_SERVOS__HEAD_PAN__MIN_ANGLE_DEG=30
DESKBOT_SERVOS__HEAD_PAN__MAX_ANGLE_DEG=150
DESKBOT_SERVOS__HEAD_TILT__GPIO_PIN=13
DESKBOT_SERVOS__HEAD_TILT__MIN_ANGLE_DEG=45
DESKBOT_SERVOS__HEAD_TILT__MAX_ANGLE_DEG=135
DESKBOT_SERVOS__LEFT_ARM__GPIO_PIN=18
DESKBOT_SERVOS__LEFT_ARM__MIN_ANGLE_DEG=20
DESKBOT_SERVOS__LEFT_ARM__MAX_ANGLE_DEG=160
DESKBOT_SERVOS__RIGHT_ARM__GPIO_PIN=19
DESKBOT_SERVOS__RIGHT_ARM__MIN_ANGLE_DEG=20
DESKBOT_SERVOS__RIGHT_ARM__MAX_ANGLE_DEG=160

# -- Audio output (speaker) ---------------------------------------------
# Backend: "mock" | "usb" | "bluetooth"
#
# For a laptop with working ALSA/PipeWire audio:
#   DESKBOT_AUDIO__BACKEND=usb
#   DESKBOT_AUDIO__OUTPUT_DEVICE=default
#
# Use "deskbot-doctor --audio" to verify speaker playback independently.
# When the backend is "mock", no physical sound is produced.  DeskBot
# logs a clear warning when running in real-hardware mode with a mock
# audio backend.
DESKBOT_AUDIO__BACKEND=mock
DESKBOT_AUDIO__OUTPUT_DEVICE=default
DESKBOT_AUDIO__SAMPLE_RATE=48000
DESKBOT_AUDIO__CHANNELS=1
DESKBOT_AUDIO__DTYPE=int16
# Bluetooth-specific (only used when BACKEND=bluetooth):
# MAC address of the A2DP sink, e.g. "AA:BB:CC:DD:EE:FF".
DESKBOT_AUDIO__BLUETOOTH_MAC=
# Friendly-name substring to match the Bluetooth device.
DESKBOT_AUDIO__BLUETOOTH_NAME=
# Auto-connect to the Bluetooth sink on first play().
DESKBOT_AUDIO__BLUETOOTH_AUTO_CONNECT=true

# -- Microphone ----------------------------------------------------------
# input_device options:
#   "default"  - use PortAudio's default input device (recommended for
#                laptops with a correctly configured default input).
#   <number>   - use a specific PortAudio device index.  Device indexes
#                are NOT stable across reboots or ALSA config changes.
#   <name>     - match a device by case-insensitive name substring.
#
# Use "deskbot-doctor --microphone" to:
#   1. enumerate available input devices
#   2. identify the PortAudio default input
#   3. show which device DeskBot would select
#   4. capture a short sample and report signal/RMS/overflows
#
# On Arch Linux with PipeWire, "default" works when the system's
# default input is configured correctly (e.g. via `wpctl status` or
# the PipeWire WirePlumber config).  No PulseAudio-specific setup is
# required.
#
# channels: 1 = mono (recommended for STT).  If the device only
#   supports stereo, set channels=2 and DeskBot will down-mix.
# sample_rate: 16000 is the STT standard.  If the device's native
#   rate differs (e.g. 48000), PortAudio/ALSA handles resampling and
#   the actual stream rate is reported in AudioChunk.sample_rate.
DESKBOT_MICROPHONE__INPUT_DEVICE=default
DESKBOT_MICROPHONE__SAMPLE_RATE=16000
DESKBOT_MICROPHONE__CHANNELS=1
DESKBOT_MICROPHONE__FRAME_MS=30
DESKBOT_MICROPHONE__DTYPE=int16

# -- Camera --------------------------------------------------------------
DESKBOT_CAMERA__DEVICE=0
DESKBOT_CAMERA__WIDTH=640
DESKBOT_CAMERA__HEIGHT=480
DESKBOT_CAMERA__FPS=30

# -- Perception (face detection) ----------------------------------------
# Enable face detection on the USB camera feed.
DESKBOT_PERCEPTION__ENABLED=true
# Seconds between face detection scans. Lower = faster reaction, more CPU.
# 0.5 is a good default for the Pi 5.
DESKBOT_PERCEPTION__SCAN_INTERVAL_S=0.5
# When the robot is IDLE, it scans for faces less often (saves CPU):
DESKBOT_PERCEPTION__IDLE_SCAN_INTERVAL_S=2.0
# When the robot is CURIOUS (tracking a face), it scans faster:
DESKBOT_PERCEPTION__CURIOUS_SCAN_INTERVAL_S=0.3
# Maximum faces to report per scan. 0 = unlimited.
DESKBOT_PERCEPTION__MAX_FACES=3
# Minimum confidence score for YuNet face detection (0.0-1.0):
DESKBOT_PERCEPTION__SCORE_THRESHOLD=0.5
# YuNet detection parameters (used when OpenCV >= 5.0).
DESKBOT_PERCEPTION__SCALE_FACTOR=1.3
DESKBOT_PERCEPTION__MIN_NEIGHBORS=4

# -- AI providers --------------------------------------------------------
# LLM provider: "mock" | "openai" | "ollama" | "custom"
DESKBOT_LLM__PROVIDER=mock
DESKBOT_LLM__MODEL=gpt-4o-mini
DESKBOT_LLM__API_KEY=
# For Ollama, set PROVIDER=ollama, MODEL=llama3.2, BASE_URL=http://localhost:11434
DESKBOT_LLM__BASE_URL=
DESKBOT_LLM__TEMPERATURE=0.7
DESKBOT_LLM__MAX_TOKENS=256
DESKBOT_LLM__TIMEOUT_S=15.0

# -- Text-to-Speech ------------------------------------------------------
# Provider: "mock" | "piper" | "elevenlabs" | "openai" | "espeak"
DESKBOT_TTS__PROVIDER=mock
DESKBOT_TTS__VOICE=default
DESKBOT_TTS__RATE=1.0

# Piper TTS (offline, on-device):
DESKBOT_TTS__PIPER__MODEL=en_US-lessac-medium
# Directory for Piper model files. Empty uses ~/.local/share/piper/.
DESKBOT_TTS__PIPER__DOWNLOAD_DIR=
DESKBOT_TTS__PIPER__USE_CUDA=false
# Speaker ID for multi-speaker models (0-based).
# DESKBOT_TTS__PIPER__SPEAKER_ID=0
# Optional Piper synthesis knobs (unset = model defaults):
# DESKBOT_TTS__PIPER__NOISE_SCALE=0.667
# DESKBOT_TTS__PIPER__LENGTH_SCALE=1.0
# DESKBOT_TTS__PIPER__NOISE_W_SCALE=0.8

# ElevenLabs TTS (cloud, paid):
DESKBOT_TTS__ELEVENLABS__API_KEY=
# Voice ID. Default "21m00Tcm4TlvDq8ikWAM" is "Rachel".
DESKBOT_TTS__ELEVENLABS__VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Model: eleven_monolingual_v1 | eleven_multilingual_v1 | eleven_multilingual_v2
DESKBOT_TTS__ELEVENLABS__MODEL_ID=eleven_multilingual_v2
DESKBOT_TTS__ELEVENLABS__STABILITY=0.5
DESKBOT_TTS__ELEVENLABS__SIMILARITY_BOOST=0.75

# -- Speech-to-Text ------------------------------------------------------
# Provider: "mock" | "whisper" | "vosk" | "google"
DESKBOT_STT__PROVIDER=mock
DESKBOT_STT__MODEL=base
DESKBOT_STT__LANGUAGE=en

# -- Wake-word detection ------------------------------------------------
# Provider: "mock" | "openwakeword" | "porcupine" | "snowboy"
#
# IMPORTANT: "energy" is NOT a valid wake-word provider. An RMS/energy
# threshold is not a wake phrase -- it wakes on any loud sound (including
# DeskBot's own TTS output) and was removed. Selecting it is a config error.
#
# Use "openwakeword" for production (recommended). "mock" auto-triggers
# after a few chunks and is intended for tests only, not production.
# If the chosen backend's dependency/model is missing, DeskBot safely
# degrades to no wake detection (NullWakeWordChecker) rather than ever
# falling back to energy detection.
DESKBOT_WAKEWORD__PROVIDER=mock
DESKBOT_WAKEWORD__PHRASE="hey deskbot"
# Confidence threshold for model-based detectors (0.0-1.0).
DESKBOT_WAKEWORD__THRESHOLD=0.5
# Optional path to a custom openWakeWord ONNX model (PROVIDER=openwakeword):
DESKBOT_WAKEWORD__MODEL_PATH=
# Porcupine-specific (PROVIDER=porcupine):
DESKBOT_WAKEWORD__PORCUPINE_ACCESS_KEY=
DESKBOT_WAKEWORD__PORCUPINE_KEYWORD=picovoice
DESKBOT_WAKEWORD__PORCUPINE_MODEL_PATH=
# Snowboy-specific (PROVIDER=snowboy):
DESKBOT_WAKEWORD__SNOWBOY_MODEL_PATH=
# Play the visual wake animation on detection.
DESKBOT_WAKEWORD__WAKE_ANIMATION=true

# -- Sound effects ------------------------------------------------------
DESKBOT_SOUNDS__ENABLED=true
DESKBOT_SOUNDS__VOLUME=0.8
DESKBOT_SOUNDS__REACTIONS_ENABLED=true

# -- Short-term conversational memory -----------------------------------
DESKBOT_MEMORY__ENABLED=true
DESKBOT_MEMORY__CAPACITY=1024
DESKBOT_MEMORY__RECALL_LIMIT=5

# -- Semantic (vector) memory -------------------------------------------
# When enabled, uses vector embeddings for semantic recall instead of
# keyword search. Requires sentence-transformers when backend != "none".
DESKBOT_VECTOR_MEMORY__ENABLED=false
# Backend: "none" (NoOp) | "sentence_transformers"
DESKBOT_VECTOR_MEMORY__BACKEND=none
DESKBOT_VECTOR_MEMORY__MODEL_NAME=all-MiniLM-L6-v2
DESKBOT_VECTOR_MEMORY__CAPACITY=2048
DESKBOT_VECTOR_MEMORY__SIMILARITY_THRESHOLD=0.3
DESKBOT_VECTOR_MEMORY__RECALL_LIMIT=5

# -- On-device learning -------------------------------------------------
# Background continual learning: records experiences and trains the
# world/action models in a daemon thread. Never blocks the main loop.
DESKBOT_LEARNING__ENABLED=false
# Store: "memory" (lost on restart) | "sqlite" (survives restarts)
DESKBOT_LEARNING__STORE=memory
DESKBOT_LEARNING__DB_PATH=~/.deskbot/experiences.db
# Memory sizes:
DESKBOT_LEARNING__WORKING_MEMORY_CAPACITY=256
DESKBOT_LEARNING__REPLAY_BUFFER_CAPACITY=10000
DESKBOT_LEARNING__EPISODIC_CAPACITY=10000
DESKBOT_LEARNING__REPLAY_SEED=42
# Training schedule:
DESKBOT_LEARNING__MIN_NEW_EXPERIENCES=32
DESKBOT_LEARNING__TRAIN_INTERVAL_S=30.0
DESKBOT_LEARNING__MIN_EXPERIENCES_FOR_TRAINING=64
# Resource limits:
DESKBOT_LEARNING__BATCH_SIZE=32
DESKBOT_LEARNING__TRAINING_EPOCHS_PER_CYCLE=5
DESKBOT_LEARNING__EVAL_SAMPLE_SIZE=128
DESKBOT_LEARNING__MAX_CPU_FRACTION=0.3
DESKBOT_LEARNING__MAX_MODEL_PARAMS=500000
# Checkpointing:
DESKBOT_LEARNING__CHECKPOINT_DIR=~/.deskbot/checkpoints
DESKBOT_LEARNING__KEEP_LAST_N_CHECKPOINTS=5
# Candidate is promoted if its loss <= current_loss * threshold.
# 1.0 = promote if equal or better; 0.95 = require 5% improvement.
DESKBOT_LEARNING__PROMOTE_THRESHOLD=1.0
# Multimodal encoding: use trainable vision/audio sub-encoders + temporal
# history for a richer state vector. Increases model size and compute.
# DESKBOT_LEARNING__USE_MULTIMODAL=false
# Number of recent state snapshots for temporal context (0 = no history).
# DESKBOT_LEARNING__MULTIMODAL_HISTORY_LENGTH=5

# -- User preference learning ------------------------------------------
DESKBOT_PREFERENCES__ENABLED=true
# Store: "memory" | "sqlite"
DESKBOT_PREFERENCES__STORE=memory
DESKBOT_PREFERENCES__DB_PATH=~/.deskbot/preferences.db

# -- Conversation persistence -------------------------------------------
DESKBOT_CONVERSATION__STORE=memory
DESKBOT_CONVERSATION__DB_PATH=~/.deskbot/conversations.db
DESKBOT_CONVERSATION__CONVERSATION_ID=default

# -- LLM tool / function calling ----------------------------------------
DESKBOT_TOOLS__ENABLED=true

# -- Plugin system ------------------------------------------------------
DESKBOT_PLUGINS__ENABLED=true
DESKBOT_PLUGINS__DISCOVER_ENTRY_POINTS=true
# Explicit plugin packages to import and register (comma-separated list):
# DESKBOT_PLUGINS__PLUGIN_PACKAGES=["my_plugin","other_plugin"]

# -- MQTT bridge --------------------------------------------------------
DESKBOT_MQTT__ENABLED=false
DESKBOT_MQTT__HOST=localhost
DESKBOT_MQTT__PORT=1883
DESKBOT_MQTT__USERNAME=
DESKBOT_MQTT__PASSWORD=
DESKBOT_MQTT__TOPIC_PREFIX=deskbot
DESKBOT_MQTT__KEEPALIVE=60
DESKBOT_MQTT__QOS=1
DESKBOT_MQTT__PUBLISH_EVENTS=true
DESKBOT_MQTT__SUBSCRIBE_COMMANDS=true
DESKBOT_MQTT__HEARTBEAT_INTERVAL=30

# -- Home Assistant MQTT discovery --------------------------------------
DESKBOT_HOMEASSISTANT__ENABLED=false
DESKBOT_HOMEASSISTANT__HOST=homeassistant.local
DESKBOT_HOMEASSISTANT__PORT=1883
DESKBOT_HOMEASSISTANT__USERNAME=
DESKBOT_HOMEASSISTANT__PASSWORD=
DESKBOT_HOMEASSISTANT__DISCOVERY_PREFIX=homeassistant
DESKBOT_HOMEASSISTANT__DEVICE_ID=deskbot
DESKBOT_HOMEASSISTANT__DEVICE_NAME=DeskBot
DESKBOT_HOMEASSISTANT__DEVICE_MANUFACTURER=DeskBot Contributors
DESKBOT_HOMEASSISTANT__DEVICE_MODEL=Desktop Companion Robot
DESKBOT_HOMEASSISTANT__QOS=1

# -- REST API + WebSocket server ----------------------------------------
DESKBOT_API__ENABLED=true
DESKBOT_API__HOST=127.0.0.1
DESKBOT_API__PORT=8000
# Shared secret for control endpoints (speak, servo, state, etc).
# When empty, no auth is enforced (only safe when bound to 127.0.0.1).
# Set to a random string when binding to 0.0.0.0.
# DESKBOT_API__API_KEY=your-secret-key-here
# CORS origins (JSON list). Default allows only the local dashboard.
# DESKBOT_API__CORS_ORIGINS=["http://localhost:8000"]

# -- Performance profiling ----------------------------------------------
# Master switch; when False all profilers are zero-overhead no-ops.
DESKBOT_PERFORMANCE__ENABLED=true
DESKBOT_PERFORMANCE__FRAME_PROFILING=true
DESKBOT_PERFORMANCE__SERVO_PROFILING=true
DESKBOT_PERFORMANCE__BUS_PROFILING=true
# Fraction of bus events to sample (0.1 = 10%).
DESKBOT_PERFORMANCE__BUS_SAMPLE_RATE=0.1
# Publish a FrameStatsReport event every N frames.
DESKBOT_PERFORMANCE__REPORT_INTERVAL_FRAMES=100


# -- Telegram bridge ----------------------------------------------------
# Chat with DeskBot and control every aspect via Telegram.
# Create a bot token with @BotFather, then enable:
#   DESKBOT_TELEGRAM__ENABLED=true
#   DESKBOT_TELEGRAM__BOT_TOKEN=123456:ABC-DEF...
# Restrict access to specific Telegram user IDs:
#   DESKBOT_TELEGRAM__ALLOWED_USER_IDS=[123456789,987654321]
# The bot forwards chat messages through the LLM conversation pipeline
# and accepts slash commands: /emotion, /state, /speak, /servo, /sound,
# /behavior, /status, /config, /help.
DESKBOT_TELEGRAM__ENABLED=false
DESKBOT_TELEGRAM__BOT_TOKEN=
DESKBOT_TELEGRAM__ALLOWED_USER_IDS=[]
DESKBOT_TELEGRAM__CHAT_TIMEOUT_S=60.0
